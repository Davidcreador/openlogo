{
  "name": "@openlogo/editor",
  "version": "0.1.0",
  "private": true,
  "description": "OpenLogo editor app: React UI shell over the CanvasKit renderer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "build:sites": "OPENLOGO_SITES_BUILD=true vite build && node scripts/check-bundle-budget.mjs dist/client --integrity-only",
    "preview": "vite preview",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openlogo/core": "workspace:*",
    "@openlogo/design-mate": "workspace:*",
    "@openlogo/foundry": "workspace:*",
    "@openlogo/renderer": "workspace:*",
    "canvaskit-wasm": "^0.40.0",
    "effect": "^3.21.4",
    "lucide-react": "^1.23.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.0.17",
    "wrangler": "4.92.0"
  }
}
