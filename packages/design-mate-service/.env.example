# Required provider settings
DESIGN_MATE_PROVIDER_API_KEY=replace-with-provider-key
DESIGN_MATE_PROVIDER_MODEL=replace-with-responses-api-model
DESIGN_MATE_PROVIDER_BASE_URL=https://api.openai.com/v1
DESIGN_MATE_PROVIDER_IMAGE_DETAIL=auto
DESIGN_MATE_PROVIDER_MAX_OUTPUT_TOKENS=1200

# Local development. For production, set DESIGN_MATE_SERVICE_TOKEN (or inject
# RequestAuth) and change this value to false.
DESIGN_MATE_ALLOW_ANONYMOUS_LOOPBACK=true
# DESIGN_MATE_SERVICE_TOKEN=replace-with-a-server-side-secret

DESIGN_MATE_SERVICE_HOST=127.0.0.1
DESIGN_MATE_SERVICE_PORT=8787
DESIGN_MATE_SERVICE_ALLOWED_ORIGINS=http://localhost:5174

# Resource and resilience limits
DESIGN_MATE_SERVICE_MAX_BODY_BYTES=5242880
DESIGN_MATE_SERVICE_MAX_JSON_DEPTH=32
DESIGN_MATE_SERVICE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
DESIGN_MATE_SERVICE_MAX_CONCURRENT_REQUESTS=16
DESIGN_MATE_SERVICE_MAX_CONCURRENT_REQUESTS_PER_SUBJECT=4
DESIGN_MATE_SERVICE_REQUEST_TIMEOUT_MS=90000
DESIGN_MATE_SERVICE_UPSTREAM_TIMEOUT_MS=60000
DESIGN_MATE_SERVICE_UPSTREAM_RETRY_ATTEMPTS=1
