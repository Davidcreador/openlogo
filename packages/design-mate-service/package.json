{
  "name": "@openlogo/design-mate-service",
  "version": "0.1.0",
  "private": true,
  "description": "Secure streaming gateway for remote Design Mate providers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "openlogo-design-mate": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/bin.ts",
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/server.js",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openlogo/design-mate": "workspace:*"
  },
  "devDependencies": {
    "@openlogo/core": "workspace:*",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
