{
  "name": "openlogo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OpenLogo — manual-first logo design studio. Kittl approachability, Illustrator precision.",
  "type": "module",
  "scripts": {
    "bench": "pnpm -r --if-present bench",
    "dev": "pnpm --filter @openlogo/editor dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "poc": "pnpm --filter openlogo-poc dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davidcreador/openlogo.git"
  },
  "license": "ISC",
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.2"
}
